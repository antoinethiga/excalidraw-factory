MODE="production"

# This copy doesn't use Excalidraw's servers: an empty value turns the service
# and its UI entries off. See "Servers configuration" in README.md to plug in
# your own servers.

# shareable links (needs VITE_APP_FIREBASE_CONFIG too)
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# public libraries site ("Browse libraries") and library publishing backend
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# Excalidraw+ links, promos and "Export to Excalidraw+"
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=

# AI features (text to diagram, wireframe to code)
VITE_APP_AI_BACKEND=

# socket server URL used for collaboration (needs VITE_APP_FIREBASE_CONFIG too)
VITE_APP_WS_SERVER_URL=

VITE_APP_FIREBASE_CONFIG=

# fonts CDN, fonts are served from this site when empty
VITE_APP_FONTS_CDN_URL=

# error reporting, disabled when empty
VITE_APP_SENTRY_DSN=

# Simple Analytics script, not loaded when empty
VITE_APP_SIMPLE_ANALYTICS_SCRIPT_URL=

VITE_APP_ENABLE_TRACKING=false

